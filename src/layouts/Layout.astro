---
import "../styles/global.css";
import "../styles/kit-room.css";
import { personal } from "../data/personal";

interface Props {
  title: string;
  description: string;
  /** Extra class on <body>, e.g. "page-labs". */
  bodyClass?: string;
}

const { title, description, bodyClass } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL("/og-image.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#FAFAF7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B1120" media="(prefers-color-scheme: dark)" />

    {/* Anti-FOUC: resolve the theme before paint and flag that JS runs (filters, menus). */}
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem("theme"); } catch (e) {}
        if (t !== "light" && t !== "dark") {
          t = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.setAttribute("data-theme", t);
        document.documentElement.classList.add("js");
      })();
    </script>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Duy Pham, Associate Product Manager, Technical PM direction" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&family=IBM+Plex+Mono:wght@500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": personal.fullName,
      "url": Astro.site?.href,
      "jobTitle": personal.title,
      "email": personal.contact.email,
      "sameAs": personal.socials.map(s => s.url),
    })} />
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">Skip to content</a>

    <slot name="header" />

    <main id="main" class="wrap">
      <slot />
    </main>

    <slot name="footer" />

    <script>
      // Reveal: patches below the first screen rise as they approach; never hidden by default.
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!reduce && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            let i = 0;
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              (entry.target as HTMLElement).style.setProperty("--d", `${i++ * 60}ms`);
              entry.target.classList.add("go");
              io.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px 15% 0px", threshold: 0 },
        );
        const vh = window.innerHeight;
        document.querySelectorAll(".reveal").forEach((el) => {
          if (el.getBoundingClientRect().top > vh * 1.15) io.observe(el);
        });
      }
    </script>
  </body>
</html>
