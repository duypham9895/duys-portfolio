---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Navbar from "../components/Navbar.astro";
import SelectedWork from "../components/SelectedWork.astro";
import ExperienceCard from "../components/ExperienceCard.astro";
import AboutCard from "../components/AboutCard.astro";
import SkillsCard from "../components/SkillsCard.astro";
import LabsPreview from "../components/LabsPreview.astro";
import CertsCoursesCard from "../components/CertsCoursesCard.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Duy Pham — Associate Product Manager · Technical PM direction"
  description="Duy Pham — Associate Product Manager in Indonesian mortgage (KPR) fintech, working toward Technical Product Manager roles. 5+ years across software engineering and product, in fintech and B2B SaaS."
>
  <Fragment slot="header">
    <Hero />
    <Navbar />
  </Fragment>

  <SelectedWork />
  <ExperienceCard />
  <AboutCard />
  <SkillsCard />
  <LabsPreview />
  <CertsCoursesCard />

  <Footer slot="footer" />
</Layout>
