---
import Layout from "../layouts/Layout.astro";
import Topbar from "../components/Topbar.astro";
import LabCard from "../components/LabCard.astro";
import Footer from "../components/Footer.astro";
import { labs } from "../data/labs";
import type { LabStatus } from "../data/labs";

// Filters: "All" plus every status that has at least one lab, in status-key order.
const STATUS_ORDER: readonly LabStatus[] = ["Live", "Building", "Paused", "Archived"];
const filters = [
  { key: "all", label: "All", count: labs.length },
  ...STATUS_ORDER.map((status) => ({
    key: status.toLowerCase(),
    label: status,
    count: labs.filter((lab) => lab.status === status).length,
  })).filter((filter) => filter.count > 0),
];
---

<Layout
  title="Labs — Duy Pham"
  description="Labs by Duy Pham: side builds to test product questions. Six projects with status, stack and links."
  bodyClass="page-labs"
>
  <Topbar slot="header" />

  <div class="sec-kicker"><span class="stripes mini" aria-hidden="true"></span><span class="label">Start list · {labs.length} entries</span></div>
  <h1 class="h">Labs</h1>
  <p class="labs-intro">Side builds.</p>

  <section class="section" style="padding-top:40px" aria-label="All labs">
    <div class="filters" role="group" aria-label="Filter by status">
      {filters.map((filter, i) => (
        <button type="button" data-f={filter.key} aria-pressed={i === 0 ? "true" : "false"}>{filter.label} · {filter.count}</button>
      ))}
    </div>

    <table class="startlist">
      <caption class="sr-only">All side projects: number, project, type, status, last updated, links</caption>
      <thead>
        <tr>
          <th scope="col" class="label">No.</th>
          <th scope="col" class="label">Project</th>
          <th scope="col" class="label">Type</th>
          <th scope="col" class="label">Status</th>
          <th scope="col" class="label">Updated</th>
          <th scope="col" class="label">Links</th>
        </tr>
      </thead>
      <tbody>
        {labs.map((project, i) => <LabCard project={project} index={i + 1} showType />)}
        <tr class="empty" hidden>
          <td colspan="6"><strong>No labs with this status.</strong>Pick another filter to see the rest.</td>
        </tr>
      </tbody>
    </table>
    <div class="chip-key" role="group" aria-label="Status key">
      {STATUS_ORDER.map((status) => <span class={`status ${status.toLowerCase()}`}>{status}</span>)}
    </div>
    <p style="margin-top:28px"><a class="btn btn-ghost" href="/">← Back to home</a></p>
  </section>

  <Footer slot="footer" slim />
</Layout>

<script>
  // Status filter + empty state. Without JS the filters stay hidden and the full list shows.
  const buttons = document.querySelectorAll<HTMLButtonElement>(".filters button");
  const rows = document.querySelectorAll<HTMLTableRowElement>(".startlist tr.row");
  const empty = document.querySelector<HTMLTableRowElement>(".startlist tr.empty");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.getAttribute("data-f");
      let shown = 0;
      buttons.forEach((other) => other.setAttribute("aria-pressed", other === button ? "true" : "false"));
      rows.forEach((row) => {
        const on = filter === "all" || row.getAttribute("data-s") === filter;
        row.hidden = !on;
        if (on) shown++;
      });
      if (empty) empty.hidden = shown !== 0;
    });
  });
</script>
