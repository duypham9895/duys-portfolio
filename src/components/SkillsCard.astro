---
import { skillGroups } from "../data/skills";
import type { Skill } from "../data/skills";

// v2 layout: Product (with story lines) | Technical depth, then a one-line engineering background.
const [product, technical, engineering] = skillGroups;
const isPrimary = (skill: Skill): boolean => skill.primary === true;
---

<section class="section" id="skills" aria-labelledby="h-skills">
  <div class="sec-head">
    <div>
      <div class="sec-kicker"><span class="stripes mini" aria-hidden="true"></span><span class="label">04</span></div>
      <h2 class="h" id="h-skills">Skills</h2>
    </div>
    <div class="legend" role="group" aria-label="Legend">
      <span class="chip pri" aria-hidden="true">Yellow</span><span class="label">= primary</span>
      <span class="chip" aria-hidden="true">Outline</span><span class="label">= other</span>
    </div>
  </div>
  <div class="grid">
    <div class="patch skillpatch span-7 reveal">
      <span class="stripes" aria-hidden="true"></span>
      <h3>{product.category}</h3>
      <ul class="pmskills">
        {product.skills.map((skill) => (
          <li><span class:list={["chip", { pri: isPrimary(skill) }]}>{skill.title}{isPrimary(skill) && <span class="sr-only"> (primary)</span>}</span>{skill.story && <p>{skill.story}</p>}</li>
        ))}
      </ul>
      {product.subgroups?.map((group) => (
        <>
          <span class="label subhead">{group.heading}</span>
          <ul class="chips">
            {group.skills.map((skill) => <li class="chip">{skill.title}</li>)}
          </ul>
        </>
      ))}
    </div>
    <div class="patch skillpatch span-5 reveal">
      <span class="stripes" aria-hidden="true"></span>
      <h3>{technical.category}</h3>
      <ul class="chips">
        {technical.skills.map((skill) => (
          <li class:list={["chip", { pri: isPrimary(skill) }]}>{skill.title}{isPrimary(skill) && <span class="sr-only"> (primary)</span>}</li>
        ))}
      </ul>
      {technical.subgroups?.map((group) => (
        <>
          <span class="label subhead">{group.heading}</span>
          <ul class="chips">
            {group.skills.map((skill) => <li class="chip">{skill.title}</li>)}
          </ul>
        </>
      ))}
    </div>
  </div>
  <div class="engline reveal">
    <span class="label">{engineering.category}</span>
    <p>{engineering.skills.map((skill) => skill.title).join(" · ")}</p>
  </div>
</section>
