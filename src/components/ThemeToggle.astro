---
/*
 * Two-state toggle: light ↔ dark.
 * On first visit (no stored choice) the inline script in Layout.astro picks
 * up OS preference. After the user clicks, the choice is persisted.
 * Styles: .theme-toggle in src/styles/kit-room.css.
 */
---

<button class="theme-toggle" type="button" aria-label="Switch to dark theme">
  <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
  <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
  <span class="tlabel" aria-hidden="true"><span class="t-to-dark">Dark</span><span class="t-to-light">Light</span></span>
</button>

<script>
  type Theme = "light" | "dark";

  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>(".theme-toggle");

  const current = (): Theme => (root.getAttribute("data-theme") === "dark" ? "dark" : "light");

  const show = (theme: Theme): void => {
    root.setAttribute("data-theme", theme);
    const next = theme === "dark" ? "light" : "dark";
    buttons.forEach((button) => button.setAttribute("aria-label", `Switch to ${next} theme`));
  };

  show(current());

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const theme: Theme = current() === "dark" ? "light" : "dark";
      show(theme);
      try {
        localStorage.setItem("theme", theme);
      } catch {}
    });
  });

  // If no manual choice yet, follow OS changes.
  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
    try {
      if (!localStorage.getItem("theme")) show(e.matches ? "dark" : "light");
    } catch {}
  });
</script>
