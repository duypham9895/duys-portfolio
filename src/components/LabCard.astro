---
import type { LabProject } from "../data/labs";

interface Props {
  project: LabProject;
  /** Row number, 1-based. */
  index: number;
  /** The /labs start list has a Type column; the home preview does not. */
  showType?: boolean;
}

const { project, index, showType = false } = Astro.props;
const number = String(index).padStart(2, "0");
const status = project.status.toLowerCase();
---

<tr class="row" data-s={status} style={`--lab:${project.accent}`}>
  <td><span class="rno">{number}</span></td>
  <td><div class="pname">{project.name}</div><p class="pdesc">{project.description}</p><span class="label ptags">{project.tags.join(" · ")}</span></td>
  {showType && <td class="c-type"><span class="ptype">{project.type}</span></td>}
  <td class="c-status"><span class={`status ${status}`}>{project.status}</span></td>
  <td class="c-upd"><span class="label"><span class="upd-k">Updated </span>{project.updatedAt}</span></td>
  <td class="c-links">
    <div class="plinks">
      {project.liveUrl && <a href={project.liveUrl} target="_blank" rel="noopener" aria-label={`${project.name} live site`}>Live ↗</a>}
      <a href={project.githubUrl} target="_blank" rel="noopener" aria-label={`${project.name} on GitHub`}>GitHub ↗</a>
    </div>
  </td>
</tr>
