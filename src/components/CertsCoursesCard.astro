---
import { certifications } from "../data/certifications";
import { parseMonth } from "../lib/seasonStrip";

const SHOWN = 3;
const sorted = [...certifications].sort((a, b) => parseMonth(b.date).getTime() - parseMonth(a.date).getTime());
const recent = sorted.slice(0, SHOWN);
const older = sorted.slice(SHOWN);
const year = (date: string): string => date.slice(-4);
---

<section class="section" id="certifications" aria-labelledby="h-certs">
  <div class="sec-head">
    <div>
      <div class="sec-kicker"><span class="stripes mini" aria-hidden="true"></span><span class="label">06 · Palmarès</span></div>
      <h2 class="h" id="h-certs">Certifications</h2>
    </div>
  </div>
  <div class="grid">
    <div class="patch span-12 reveal" style="overflow:hidden">
      <div class="palm-head">
        <span class="stripes" aria-hidden="true"></span>
        <p class="label">{SHOWN} most recent · newest first</p>
      </div>
      <ol class="palm">
        {recent.map((cert) => (
          <li><span class="yr">{year(cert.date)}</span><span><span class="nm">{cert.name}</span><span class="label iss">{cert.organization} · {cert.date}</span></span><a href={cert.credentialUrl} target="_blank" rel="noopener" aria-label={`Verify ${cert.shortName} credential`}>Verify ↗</a></li>
        ))}
      </ol>
      {older.length > 0 && (
        <details class="palm-all">
          <summary>Show all ({sorted.length})</summary>
          <ol class="palm" start={SHOWN + 1}>
            {older.map((cert) => (
              <li><span class="yr">{year(cert.date)}</span><span><span class="nm">{cert.name}</span><span class="label iss">{cert.organization} · {cert.date}</span></span><a href={cert.credentialUrl} target="_blank" rel="noopener" aria-label={`Verify ${cert.shortName} credential`}>Verify ↗</a></li>
            ))}
          </ol>
        </details>
      )}
    </div>
  </div>
</section>
